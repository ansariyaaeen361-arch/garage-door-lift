# systemd unit for the Garage Door Lift Node app.
# Install once on the VPS: sudo cp deploy/garage-door-lift.service /etc/systemd/system/
# Then: sudo systemctl daemon-reload && sudo systemctl enable --now garage-door-lift

[Unit]
Description=Garage Door Lift Node app
After=network.target

[Service]
Type=simple
# Change /var/www/garage-door to wherever you clone the repo on the VPS.
WorkingDirectory=/var/www/garage-door/server
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3000
# node:sqlite is still experimental — this silences the flag requirement on older Node builds.
Environment=NODE_OPTIONS=--no-warnings

# Run as a dedicated, unprivileged user (create with: sudo useradd -r -s /sbin/nologin gdlapp)
User=gdlapp
Group=gdlapp

[Install]
WantedBy=multi-user.target
